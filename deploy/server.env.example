# The server reads this file through Docker Compose. Keep the real .env at mode 600.
IMAGE_TAG=latest
APP_HTTP_PORT=18080
APP_VERSION=0.13.0
LOG_LEVEL=INFO

APP_ENV=production
PUBLIC_APP_URL=https://image.example.com
DATABASE_URL=postgresql+asyncpg://user:password@host/database?ssl=require

# Generate these once and back them up outside the server.
APP_CONFIG_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
AUTH_TOKEN_PEPPER=replace-with-an-independent-random-value
AUTH_HASH_SALT=replace-with-another-independent-random-value

# Sub2API and R2 credentials are configured after sign-in from the admin console.
