# Required by Docker Compose. Use a long URL-safe value in production.
POSTGRES_PASSWORD=replace-with-a-long-random-password
HTTP_PORT=8080
APP_HTTP_PORT=18080
IMAGE_TAG=latest
APP_VERSION=0.13.0
LOG_LEVEL=INFO

# 256-bit AES-GCM root key. Generate with: openssl rand -base64 32
# It must never be committed, stored in PostgreSQL, or exposed to the browser.
APP_CONFIG_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key

# Generate independent random values of at least 32 characters. Do not reuse them.
AUTH_TOKEN_PEPPER=replace-with-a-unique-random-token-pepper
AUTH_HASH_SALT=replace-with-a-different-random-hash-salt
SESSION_COOKIE_NAME=sub2image_session
SESSION_COOKIE_SECURE=true
PUBLIC_APP_URL=https://studio.example.com
AUTH_SESSION_TTL_DAYS=30
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_ACCOUNT_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=25
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
POINT_ADJUSTMENT_APPROVAL_THRESHOLD=1000
JOB_QUOTE_TTL_SECONDS=300
ADMIN_EXPORT_TTL_SECONDS=300

# Local defaults. Docker Compose overrides these with its internal service addresses
# and production guards. Set real local service addresses before running local workers.
DATABASE_URL=postgresql+asyncpg://sub2image:replace-with-a-long-random-password@127.0.0.1:5432/sub2image
REDIS_URL=redis://127.0.0.1:6379/0
DEPENDENCY_CHECKS_ENABLED=false
LEGACY_SYNC_API_ENABLED=true
# Simultaneous image jobs per worker (1–8). Admin task_concurrency also caps queued + running jobs.
WORKER_MAX_JOBS=2
WORKER_JOB_TIMEOUT_SECONDS=600

# Business configuration is created through /api/v1/admin/config after bootstrap.
# Do not place Sub2API, R2, or email credentials in this file.
ASSET_DELETE_GRACE_DAYS=7
ASSET_ORPHAN_GRACE_HOURS=24

# Local processing compatibility settings.
RESULT_TTL_HOURS=24
BACKGROUND_MODEL=u2net
